# .env.example
PROJECT_NAME="POLAROPS API"
VERSION="1.0.0"
API_V1_STR="/api"

# Use sqlite for local dev, postgres for prod
DATABASE_URL="sqlite:///./polarops.db"
# DATABASE_URL="postgresql://user:password@localhost/polarops"

# CORS origins (comma separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
