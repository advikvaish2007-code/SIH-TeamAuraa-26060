{
  "name": "polarops-workspace",
  "version": "1.0.0",
  "description": "PolarOps Full-Stack Application",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && venv\\Scripts\\uvicorn.exe app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
